{
  "$id": "https://opendatafabric.org/schemas/dataset/v1alpha1/DatasetRef",
  "$schema": "https://opendatafabric.org/schemas/metaschemas/v1alpha1/ResourceRef",
  "description": "Reference to a dataset.",
  "format": "struct-or-string",
  "required": [],
  "oneOf": [
    {
      "type": "string"
    },
    {
      "type": "object",
      "required": [],
      "properties": {
        "account": {
          "$ref": "https://opendatafabric.org/schemas/auth/v1alpha1/AccountRef",
          "description": "Reference to an account that owns the dataset.",
          "unevaluatedProperties": false
        },
        "id": {
          "type": "string",
          "format": "resource-id",
          "description": "UUID of the dataset resource."
        },
        "did": {
          "type": "string",
          "format": "dataset-id",
          "description": "DID of the dataset."
        },
        "name": {
          "type": "string",
          "format": "resource-name",
          "description": "Name of the dataset."
        }
      }
    }
  ]
}
