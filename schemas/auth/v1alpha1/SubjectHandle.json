              "const": "Anonymous"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "$ref": "#/$defs/Anonymous"
        }
      ]
    },
    {
      "allOf": [
        {
          "properties": {
            "kind": {
              "type": "string",
              "const": "Everyone"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "$ref": "#/$defs/Everyone"
        }
      ]
    }
