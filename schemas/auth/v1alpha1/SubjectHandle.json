{
  "$id": "https://opendatafabric.org/schemas/auth/v1alpha1/SubjectHandle",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Resolved reference to a party a grant is given to.",
  "codegen": {
    "rust": {
      "dtoType": "SubjectHandle"
    }
  },
  "$defs": {
    "Principal": {
      "description": "A specific `User`, `ServiceAccount`, or `Node`.",
      "type": "object",
      "required": [
        "type",
        "id",
        "name"
      ],
      "properties": {
        "type": {
          "type": "string",
          "format": "type-uri",
          "description": "Type URI of the principal."
        },
        "account": {
          "$ref": "https://opendatafabric.org/schemas/auth/v1alpha1/ResourceOwnerHandle",
          "description": "Account that owns the service account.",
          "unevaluatedProperties": false
        },
        "id": {
          "type": "string",
          "format": "resource-id",
          "description": "ID of the principal resource."
        },
        "did": {
          "type": "string",
          "format": "did",
          "description": "DID of the principal, if applicable."
        },
        "name": {
          "type": "string",
          "format": "resource-name",
          "description": "Name of the principal resource."
        }
      }
    },
    "Group": {
      "description": "Members of a `Group`, including members of nested groups.",
      "type": "object",
      "required": [
        "account",
        "id",
        "name"
      ],
      "properties": {
        "account": {
          "$ref": "https://opendatafabric.org/schemas/auth/v1alpha1/ResourceOwnerHandle",
          "description": "Account that owns the group.",
          "unevaluatedProperties": false
        },
        "id": {
          "type": "string",
          "format": "resource-id",
          "description": "ID of the group resource."
        },
        "name": {
          "type": "string",
          "format": "resource-name",
          "description": "Name of the group resource."
        }
      }
    },
    "Authenticated": {
      "description": "Matches any authenticated principal.",
      "type": "object",
      "required": [],
      "properties": {}
    },
    "Anonymous": {
      "description": "Matches any unauthenticated principal.",
      "type": "object",
      "required": [],
      "properties": {}
    },
    "Everyone": {
      "description": "Matches any principal, authenticated or not.",
      "type": "object",
      "required": [],
      "properties": {}
    }
  },
  "oneOf": [
    {
      "allOf": [
        {
          "properties": {
            "kind": {
              "type": "string",
