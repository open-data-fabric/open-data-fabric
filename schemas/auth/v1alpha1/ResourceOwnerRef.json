{
  "$id": "https://opendatafabric.org/schemas/auth/v1alpha1/ResourceOwnerRef",
  "$schema": "https://opendatafabric.org/schemas/resources/v1alpha1/meta/ResourceRef",
  "description": "Reference to an account that can own resources: `User`, `Organization`, or `Node`. Short form is the account name, as names of these accounts are unique within a node.",
  "format": "struct-or-string",
  "required": [],
  "oneOf": [
    {
      "type": "string"
    },
    {
      "type": "object",
      "required": [],
      "properties": {
        "type": {
          "type": "string",
          "format": "type-ref",
          "description": "Name or URI of the account type."
        },
        "id": {
          "type": "string",
          "format": "resource-id",
          "description": "UUID of the account resource."
        },
        "did": {
          "type": "string",
          "format": "account-did",
          "description": "DID of the account."
        },
        "name": {
          "type": "string",
          "format": "account-name",
          "description": "Name of the account."
        }
      }
    }
  ]
}
