{
  "$id": "https://opendatafabric.org/schemas/datasets/v1alpha1/DatasetHandle",
  "$schema": "https://opendatafabric.org/schemas/resources/v1alpha1/meta/ResourceHandle",
  "description": "Link to a dataset.",
  "type": "object",
  "required": [
    "id",
    "did",
    "name"
  ],
  "properties": {
    "account": {
      "$ref": "https://opendatafabric.org/schemas/auth/v1alpha1/AccountHandle",
      "description": "Reference to an account that owns the dataset.",
      "unevaluatedProperties": false
    },
    "id": {
      "type": "string",
      "format": "resource-id",
      "description": "ID of the dataset resource."
    },
    "did": {
      "type": "string",
      "format": "dataset-id",
      "description": "DID of the dataset."
    },
    "name": {
      "type": "string",
      "format": "resource-name",
      "description": "Name of the dataset."
    }
  }
}