{
  "$id": "https://opendatafabric.org/schemas/sinks/v1alpha1/WebhookEndpointSpecInput",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "canonicalType": "https://opendatafabric.org/schemas/sinks/v1alpha1/WebhookEndpointSpec",
  "description": "Defines a webhook endpoint that can receive event notifications and data.",
  "type": "object",
  "required": [
    "url"
  ],
  "properties": {
    "url": {
      "type": "string",
      "format": "uri",
      "description": "URL of the webhook endpoint."
    },
    "secret": {
      "$ref": "https://opendatafabric.org/schemas/config/v1alpha1/Secret",
      "description": "Shared secret used for HMAC signature of the request payload for authentication.",
      "unevaluatedProperties": false
    }
  }
}
