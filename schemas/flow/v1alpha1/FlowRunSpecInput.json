{
  "$id": "https://opendatafabric.org/schemas/flow/v1alpha1/FlowRunSpecInput",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "canonicalType": "https://opendatafabric.org/schemas/flow/v1alpha1/FlowRunSpec",
  "description": "Defines a set of tasks to be executed in a sequence.",
  "type": "object",
  "required": [
    "tasks"
  ],
  "properties": {
    "target": {
      "$ref": "https://opendatafabric.org/schemas/resource/v1alpha1/ResourceRef",
      "unevaluatedProperties": false,
      "description": "Defines the default target resources on which tasks will be performed."
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "https://opendatafabric.org/schemas/task/v1alpha1/TaskSpecInput",
        "unevaluatedProperties": false
      },
      "description": "List of tasks to run consecutively."
    }
  }
}
