{
  "$id": "https://opendatafabric.org/schemas/resources/v1alpha1/ResourcePhase",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Represents the reconciliation or deletion phase of a resource.",
  "type": "string",
  "enum": [
    "Pending",
    "Reconciling",
    "Ready",
    "Degraded",
    "Failed",
    "Deleting",
    "Deleted"
  ]
}
